# Your API keys: never commit them
.env

# Setups you make (setups/my-…) are yours: never committed, never touched by git pull
setups/my-*/

# Everything a run makes is yours, traces/ and evals/ included: keep only the files that define a setup
setups/*/*
!setups/*/spec.md
!setups/*/harness.toml
!setups/*/golden.jsonl
