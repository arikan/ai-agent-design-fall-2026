# Copy this file to .env and paste your key after the = sign:
#   cp .env.example .env
# .env is ignored by git. Never commit, zip, or paste it anywhere.

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: one model for every setup, instead of each harness.toml's model line.
# Examples: ollama/gemma3, openrouter/google/gemini-2.5-flash
MVA_MODEL=
